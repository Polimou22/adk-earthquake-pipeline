# Gemini API key from https://aistudio.google.com/apikey (required)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Optional: Google Cloud Storage upload. Leave GCS_BUCKET blank to keep files local only.
GCS_BUCKET=
# Only needed if GCS_BUCKET is set: path to your service account JSON key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
